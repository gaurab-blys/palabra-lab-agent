{
  "name": "palabra-twilio-lab",
  "version": "1.0.0",
  "description": "Standalone lab for Palabra AI + Twilio outbound Connect/Stream voice translation testing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --passWithNoTests",
    "call": "node scripts/place-call.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@twilio/voice-sdk": "^2.12.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "twilio": "^4.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
